{
  "name": "python-layer",
  "version": "1.0.0",
  "description": "Python layer for aggregation and Arrow/JSON formatting",
  "private": true,
  "scripts": {
    "install:python": "python -m pip install -r requirements.txt",
    "dev": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "echo 'Python build complete'",
    "test": "python -m pytest tests/ -v",
    "lint": "python -m ruff check .",
    "format": "python -m black . && python -m ruff check --fix .",
    "clean": "find . -type d -name '__pycache__' -exec rm -rf {} + && find . -type f -name '*.pyc' -delete"
  }
}
